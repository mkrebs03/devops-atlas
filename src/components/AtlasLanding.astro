---
/*
  The landing is its own surface, not the docs index wearing a headline. It
  answers three questions in order — what this is, what is inside, what a page
  actually looks like — and then gets out of the way.

  Every number and every sample below is real content from this repository.
*/
import { modules, pages, getLocalizedPath } from '../data/curriculum.mjs';
import { t } from '../data/ui-text.mjs';

interface Props { locale: 'es' | 'en' }

const { locale } = Astro.props;
const copy = t(locale);
const en = locale === 'en';
const base = en ? '/en/' : '/';
const practiceCount = pages.filter((page) => page.kind === 'practice').length;

const words = en
  ? {
      display: ['Learn DevOps', 'by reading how it', 'actually behaves.'],
      lede: 'A DevOps reference for developers who already code: concepts explained to build a mental model, tools documented as they behave, and walkthroughs you run on your own machine.',
      start: 'Start with Foundations',
      browse: 'Browse tools A–Z',
      whatInside: 'What is inside',
      sample: 'What a page looks like',
      sampleLede: 'Pages separate the boundaries a request crosses, then show the evidence that tells them apart — real commands, real output.',
      sampleCaption: 'From Foundations · Essential networking',
      openSource: 'Free and open. Every page exists in Spanish and English.',
    }
  : {
      display: ['Aprende DevOps', 'leyendo cómo se', 'comporta de verdad.'],
      lede: 'Referencia de DevOps para quien ya programa: conceptos explicados para construir un modelo mental, herramientas documentadas como se comportan y prácticas que ejecutas en tu propia máquina.',
      start: 'Empezar por Fundamentos',
      browse: 'Ver herramientas A–Z',
      whatInside: 'Qué hay dentro',
      sample: 'Cómo se ve una página',
      sampleLede: 'Las páginas separan las fronteras que atraviesa una petición y muestran la evidencia que las distingue: comandos reales, salida real.',
      sampleCaption: 'De Fundamentos · Redes esenciales',
      openSource: 'Libre y abierto. Cada página existe en español y en inglés.',
    };
---

<div class="landing">
  <section class="landing__hero">
    <h1 class="landing__display">
      {words.display.map((line) => <span>{line}</span>)}
    </h1>
    <p class="landing__lede">{words.lede}</p>
    <p class="landing__actions">
      <a class="landing__cta" href={getLocalizedPath('foundations.overview', locale)}>{words.start}</a>
      <a class="landing__ghost" href={`${base}tools/`}>{words.browse}</a>
    </p>
    <dl class="landing__facts">
      <div><dt>{modules.length}</dt><dd>{copy.modules.toLowerCase()}</dd></div>
      <div><dt>{pages.length}</dt><dd>{copy.pages}</dd></div>
      <div><dt>{practiceCount}</dt><dd>{en ? 'walkthroughs' : 'prácticas'}</dd></div>
    </dl>
  </section>

  <section class="landing__section">
    <h2>{words.whatInside}</h2>
    <div class="landing__grid">
      {modules.map((module) => (
        <a class="mcard" href={getLocalizedPath(`${module.id}.overview`, locale)}>
          <span class="mcard__no">{String(module.order).padStart(2, '0')}</span>
          <h3>{module.label[locale]}</h3>
          <p>{module.summary[locale]}</p>
          <ul class="mcard__pages">
            {module.pages.map((page) => <li>{page.label[locale]}</li>)}
          </ul>
          <ul class="mcard__tools">
            {module.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <section class="landing__section landing__sample">
    <div>
      <h2>{words.sample}</h2>
      <p class="landing__sample-lede">{words.sampleLede}</p>
      <p class="landing__sample-caption">{words.sampleCaption}</p>
    </div>
    <figure class="term">
      <figcaption class="term__bar">
        <span class="term__dot" aria-hidden="true"></span>
        <span>bash</span>
      </figcaption>
      <pre><code><span class="term__p">$</span> ss -lnt | grep ':8080'
<span class="term__o">LISTEN 0  5  0.0.0.0:8080  0.0.0.0:*</span>
<span class="term__p">$</span> curl -i http://127.0.0.1:8080/
<span class="term__ok">HTTP/1.0 200 OK</span>
<span class="term__o">atlas is listening</span>

<span class="term__p">$</span> curl -i http://127.0.0.1:9090/
<span class="term__err">curl: (7) Failed to connect to 127.0.0.1 port 9090: Connection refused</span></code></pre>
    </figure>
  </section>

  <p class="landing__foot">{words.openSource}</p>
</div>
