---
/*
  The landing is its own surface, not the docs index wearing a headline. It
  answers, in order: what this is, who writes it, what is inside and where to
  enter. The ways in are links in the prose rather than buttons.
*/
import { modules, getLocalizedPath } from '../data/curriculum.mjs';

interface Props { locale: 'es' | 'en' }

const { locale } = Astro.props;
const en = locale === 'en';
const base = en ? '/en/' : '/';

const words = en
  ? {
      whatInside: 'What is inside',
      insideLede: 'The modules follow the path of a change, from the machine to production. They can be read in order or one at a time.',
      assumes: 'The pages assume you already write code, and every one of them exists in Spanish and in English.',
      missing: 'I have not written yet about public clouds, security, or Kubernetes beyond an introduction.',
      backToTop: 'Back to top',
    }
  : {
      whatInside: 'Qué hay dentro',
      insideLede: 'Los módulos siguen el recorrido de un cambio, desde la máquina hasta producción. Se pueden leer en orden o sueltos.',
      assumes: 'Las páginas asumen que ya programas, y cada una existe en español y en inglés.',
      missing: 'Todavía no he escrito sobre nubes públicas, seguridad ni Kubernetes más allá de una introducción.',
      backToTop: 'Volver arriba',
    };
---

<div class="landing">
  <section class="landing__hero">
    <h1 class="landing__display">DevOps Atlas</h1>
    {en ? (
      <>
        <p class="landing__lede">DevOps notes organized as a reference, in Spanish and English.</p>
        <p class="landing__lede">
          I'm Martín Sanhueza Krebs. I study computer engineering at Universidad de La Frontera and I put these notes
          together as I learn. Some of what is here I run every day and some I have only studied;
          <a href={`${base}about/`}>About this site</a> says which is which.
        </p>
        <p class="landing__lede">
          Inside there are modules that go from reading a machine to describing infrastructure in a file,
          a <a href={`${base}glossary/`}>glossary</a>, an <a href={`${base}tools/`}>A–Z index of tools</a>, and
          written walkthroughs on a single <a href={`${base}sample-app/`}>sample application</a>. If you arrive
          without a topic in mind, <a href={`${base}what-is-devops/`}>What DevOps is</a> is the first page.
        </p>
      </>
    ) : (
      <>
        <p class="landing__lede">Apuntes de DevOps organizados como referencia, en español y en inglés.</p>
        <p class="landing__lede">
          Soy Martín Sanhueza Krebs, estudio Ingeniería Informática en la Universidad de La Frontera y voy armando
          estos apuntes a medida que aprendo. Una parte de lo que hay aquí la opero a diario y otra solo la he
          estudiado; en <a href={`${base}about/`}>Sobre este sitio</a> digo cuál es cuál.
        </p>
        <p class="landing__lede">
          Dentro hay módulos que van desde leer una máquina hasta describir la infraestructura en un archivo,
          un <a href={`${base}glossary/`}>glosario</a>, un <a href={`${base}tools/`}>índice de herramientas A–Z</a> y
          prácticas escritas sobre una misma <a href={`${base}sample-app/`}>aplicación de ejemplo</a>. Si llegas sin
          un tema en mente, <a href={`${base}what-is-devops/`}>Qué es DevOps</a> es la primera página.
        </p>
      </>
    )}
  </section>

  <section class="landing__section">
    <h2>{words.whatInside}</h2>
    <p class="landing__intro">{words.insideLede}</p>
    <div class="landing__grid">
      {modules.map((module) => (
        <a class="mcard" href={getLocalizedPath(`${module.id}.overview`, locale)}>
          <span class="mcard__no">{String(module.order).padStart(2, '0')}</span>
          <h3>{module.label[locale]}</h3>
          <p>{module.summary[locale]}</p>
          <ul class="mcard__pages">
            {module.pages.map((page) => <li>{page.label[locale]}</li>)}
          </ul>
          <ul class="mcard__tools">
            {module.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <div class="landing__foot">
    <p>{words.assumes}</p>
    <p>{words.missing}</p>
  </div>

  <button type="button" class="landing__totop" aria-label={words.backToTop} data-atlas-top>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </button>
</div>

<script>
  /*
    Appears once the hero has scrolled past — before that, the sticky header's
    wordmark already is the way home, so a second one would be noise.
  */
  const button = document.querySelector<HTMLButtonElement>('[data-atlas-top]');
  const hero = document.querySelector('.landing__hero');
  if (button && hero) {
    const sync = () => {
      button.toggleAttribute('data-visible', hero.getBoundingClientRect().bottom < 0);
    };
    window.addEventListener('scroll', sync, { passive: true });
    sync();
    button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
