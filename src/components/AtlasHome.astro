---
import ProgressSummary from './ProgressSummary.astro';
import {
  getLocalizedStepPath,
  learningModules,
  learningSteps,
  selectLabStep,
} from '../data/learning-path.mjs';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const t = locale === 'en'
  ? {
      eyebrow: 'A guided path through DevOps',
      title: 'Understand the path from terminal to production.',
      intro: 'Learn the systems, collaboration habits, and delivery tools behind reliable software—one practical step at a time.',
      start: 'Start the route', continue: 'Continue learning', review: 'Review the route', explore: 'Explore the full route',
      scope: '3 modules · 12 steps · 3 practical labs', path: 'Your learning route', pathIntro: 'Each stage builds the mental model for the next.',
      steps: 'steps', minutes: 'min', open: 'Open module', entry: 'Choose how to begin',
      zero: 'Start from zero', zeroBody: 'Follow the complete sequence with no prior DevOps knowledge.',
      lab: 'Open a lab', labBody: 'Learn by doing in a safe, local environment.',
      resume: 'Resume your progress', resumeBody: 'Return to the next useful step in your route.',
      method: 'How the Atlas teaches', understand: 'Understand', understandBody: 'Build a mental model before memorizing commands.',
      practice: 'Practice', practiceBody: 'Use small local labs to turn concepts into evidence.', verify: 'Verify', verifyBody: 'Check the result and explain what changed.',
    }
  : {
      eyebrow: 'Una ruta guiada por DevOps',
      title: 'Entiende el recorrido desde la terminal hasta producción.',
      intro: 'Aprende los sistemas, hábitos de colaboración y herramientas de entrega detrás de software confiable, paso a paso y con práctica.',
      start: 'Comenzar la ruta', continue: 'Continuar aprendiendo', review: 'Revisar la ruta', explore: 'Explorar la ruta completa',
      scope: '3 módulos · 12 etapas · 3 laboratorios prácticos', path: 'Tu ruta de aprendizaje', pathIntro: 'Cada etapa construye el modelo mental de la siguiente.',
      steps: 'etapas', minutes: 'min', open: 'Abrir módulo', entry: 'Elige cómo comenzar',
      zero: 'Empezar desde cero', zeroBody: 'Sigue la secuencia completa sin conocimientos previos de DevOps.',
      lab: 'Abrir un laboratorio', labBody: 'Aprende haciendo en un entorno local y seguro.',
      resume: 'Retomar tu avance', resumeBody: 'Vuelve al siguiente paso útil de tu recorrido.',
      method: 'Cómo enseña el Atlas', understand: 'Entender', understandBody: 'Construye un modelo mental antes de memorizar comandos.',
      practice: 'Practicar', practiceBody: 'Usa laboratorios locales pequeños para convertir conceptos en evidencia.', verify: 'Verificar', verifyBody: 'Comprueba el resultado y explica qué cambió.',
    };

const firstStep = learningSteps[0];
const firstLab = selectLabStep();
const firstPath = getLocalizedStepPath(firstStep, locale)!;
const labPath = getLocalizedStepPath(firstLab, locale)!;
const totalMinutes = learningSteps.reduce((sum, step) => sum + step.minutes, 0);
---

<div class="atlas-home" data-learning-progress data-locale={locale}>
  <section class="learning-hero" aria-labelledby="_top">
    <div class="learning-hero__copy">
      <p class="atlas-kicker">{t.eyebrow}</p>
      <h1 id="_top">{t.title}</h1>
      <p class="learning-hero__lede">{t.intro}</p>
      <p class="learning-hero__scope">{t.scope} · {Math.round(totalMinutes / 60)}h</p>
      <div class="learning-actions">
        <a class="atlas-action atlas-action--primary" href={firstPath} data-resume-link data-label-start={t.start} data-label-continue={t.continue} data-label-review={t.review}>
          <span data-resume-label>{t.start}</span><span aria-hidden="true">→</span>
        </a>
        <a class="atlas-action atlas-action--quiet" href="#learning-path">{t.explore}</a>
      </div>
    </div>
    <div class="learning-hero__summary" aria-label={locale === 'en' ? 'Course progress' : 'Progreso del curso'}>
      <span class="learning-hero__number" data-course-percent>0%</span>
      <ProgressSummary locale={locale} />
      <p data-progress-personalized hidden>{locale === 'en' ? 'Your progress is saved on this device.' : 'Tu avance se guarda en este dispositivo.'}</p>
    </div>
  </section>

  <section class="atlas-section learning-route" id="learning-path" aria-labelledby="learning-path-title">
    <header class="atlas-section__heading">
      <div><p class="atlas-kicker">{t.path}</p><h2 id="learning-path-title">{t.pathIntro}</h2></div>
    </header>
    <ol class="learning-module-list">
      {learningModules.map((module) => {
        const moduleMinutes = module.steps.reduce((sum, step) => sum + step.minutes, 0);
        return (
          <li class={`learning-module learning-module--${module.id}`} data-module-id={module.id}>
            <div class="learning-module__header">
              <span class="learning-module__index">0{module.order}</span>
              <div><h3>{module.label[locale]}</h3><p>{module.outcome[locale]}</p></div>
              <span class="learning-module__meta">{module.steps.length} {t.steps} · {moduleMinutes} {t.minutes}</span>
            </div>
            <ProgressSummary moduleId={module.id} locale={locale} compact />
            <ol class="learning-step-list">
              {module.steps.map((step) => (
                <li data-progress-step={step.id} data-progress-state="pending">
                  <a href={getLocalizedStepPath(step, locale)}>
                    <span class="learning-step__status" aria-hidden="true" data-progress-status>○</span>
                    <span><strong>{step.label[locale]}</strong><small>{step.minutes} {t.minutes}</small></span>
                  </a>
                </li>
              ))}
            </ol>
            <a class="learning-module__link" href={getLocalizedStepPath(module.steps[0], locale)}>{t.open} <span aria-hidden="true">→</span></a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="atlas-section learning-entry" aria-labelledby="learning-entry-title">
    <header class="atlas-section__heading"><div><p class="atlas-kicker">{t.entry}</p><h2 id="learning-entry-title">{locale === 'en' ? 'One goal, three useful starting points.' : 'Un objetivo, tres puntos de partida útiles.'}</h2></div></header>
    <div class="learning-entry__grid">
      <a href={firstPath}><span>01</span><h3>{t.zero}</h3><p>{t.zeroBody}</p></a>
      <a href={labPath} data-lab-link><span>02</span><h3>{t.lab}</h3><p>{t.labBody}</p></a>
      <a href={firstPath} data-resume-link><span>03</span><h3 data-resume-label>{t.resume}</h3><p>{t.resumeBody}</p></a>
    </div>
  </section>

  <section class="atlas-section learning-method" aria-labelledby="learning-method-title">
    <header><p class="atlas-kicker">{t.method}</p><h2 id="learning-method-title">{locale === 'en' ? 'A repeatable way to learn systems.' : 'Una forma repetible de aprender sistemas.'}</h2></header>
    <ol><li><span>01</span><h3>{t.understand}</h3><p>{t.understandBody}</p></li><li><span>02</span><h3>{t.practice}</h3><p>{t.practiceBody}</p></li><li><span>03</span><h3>{t.verify}</h3><p>{t.verifyBody}</p></li></ol>
  </section>
</div>

<script>
  import { initLearningProgress } from '../scripts/learning-progress';
  initLearningProgress();
  document.addEventListener('astro:page-load', initLearningProgress);
</script>
