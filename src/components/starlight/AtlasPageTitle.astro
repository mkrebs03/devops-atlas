---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import LessonHeader from '../LessonHeader.astro';
import { getLearningStepByPath } from '../../data/learning-path.mjs';

const { entry, lang } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const step = getLearningStepByPath(Astro.url.pathname);
const locale = lang === 'en' ? 'en' : 'es';
---

{step ? <LessonHeader step={step} data={entry.data} locale={locale} /> : !isSplash && <DefaultPageTitle />}
