---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import LessonCompletion from '../LessonCompletion.astro';
import MermaidRunner from './MermaidRunner.astro';
import { getLearningStepByPath, learningSteps } from '../../data/learning-path.mjs';
const { entry, lang } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const step = getLearningStepByPath(Astro.url.pathname);
const locale = lang === 'en' ? 'en' : 'es';
const next = step ? learningSteps.find((item) => item.order === step.order + 1) : undefined;
---
{step && <LessonCompletion step={step} next={next} takeaways={entry.data.takeaways} locale={locale} />}
{!isSplash && !step && <DefaultFooter />}
{!isSplash && <MermaidRunner />}
